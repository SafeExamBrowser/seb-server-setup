SEBSERVER_PWD=somePW
EXTERNAL_DNS_NAME=localhost

# This is used to define the name of the docker volume for the database.
# This is for convenience for testing different setups but also with different DB's locally
# Usually you do not need to change this except you already changed this volume name in your docker-compose.yml file
# Per default it points to the name used in previous version.
DB_VOLUME_NAME=seb-demo-server-db

# This is the SEB Server version that is used as tag name for Docker image pull.
# The tags has the following structure (M=Major,m=Minor, p=Patch -number)
# - vM.m-latest points to the latest built image of a specific minor version and is manly used for development
# - vM.m-stable points to the latest stable version of a specific minor version that usually is the lates patch version
# - vM.m.p pounts to a specific release or patch version
SEBSERVER_VERSION=v3.0-latest