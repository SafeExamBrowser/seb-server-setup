# This is the password that is internally by SEB Server
# to encrypt sensitve data or securtly connect to other services
# Once you have setup your SEB Server, do not change this passeword
SEBSERVER_PWD=somePW

# This ist the internal database user password
# Once you have setup your SEB Server, do not change this passeword
DB_SA_PWD=somePW

# This is the URI domain name where your SEB service is avialable from the internet or intranet
DNS_NAME=localhost